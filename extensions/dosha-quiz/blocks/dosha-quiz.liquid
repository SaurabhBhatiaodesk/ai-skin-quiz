{% render 'quiz-widget', block: block, expected_layout: 'three' %}
{% schema %}
{
    "name":  "Combined Quiz",
    "target":  "section",
    "stylesheet":  "dosha-quiz.css",
    "javascript":  "dosha-quiz.js",
    "settings":  [
                     {
                         "type":  "text",
                         "id":  "brand_name",
                         "label":  "Brand name",
                         "default":  "PRANA Beauty \u0026 Wellness"
                     },
                     {
                         "type":  "text",
                         "id":  "hero_title",
                         "label":  "Heading",
                         "default":  "Find Your"
                     },
                     {
                         "type":  "text",
                         "id":  "hero_accent",
                         "label":  "Heading accent",
                         "default":  "Skin Ritual"
                     },
                     {
                         "type":  "text",
                         "id":  "hero_subtitle",
                         "label":  "Subtitle",
                         "default":  "Three paths. One result. Your personal Ayurvedic ritual."
                     },
                     {
                         "type":  "text",
                         "id":  "quiz_code",
                         "label":  "Shopify widget code",
                         "default":  "dosha-quiz",
                         "info":  "Paste the Shopify widget code from the app Blocks page, for example john-smith."
                     },
                     {
                         "type":  "text",
                         "id":  "privacy_url",
                         "label":  "Privacy policy URL",
                         "default":  "/pages/privacy-policy"
                     }
                 ]
}
{% endschema %}
