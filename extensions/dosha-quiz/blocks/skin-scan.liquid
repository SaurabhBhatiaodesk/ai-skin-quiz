{% render 'quiz-widget', block: block, expected_layout: 'scan' %}
{% schema %}
{
  "name": "Only Skin Scan",
  "target": "section",
  "stylesheet": "dosha-quiz.css",
  "javascript": "dosha-quiz.js",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "info": "Leave blank to use your store name."
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Heading",
      "default": "AI Skin Scan"
    },
    {
      "type": "text",
      "id": "hero_accent",
      "label": "Heading accent",
      "default": "Skin observations"
    },
    {
      "type": "text",
      "id": "hero_subtitle",
      "label": "Subtitle",
      "default": "A photo-based skin reading. Your personal Ayurvedic ritual."
    },
    {
      "type": "text",
      "id": "quiz_code",
      "label": "App block widget ID",
      "info": "Paste the numeric widget ID of an Only Skin Scan quiz from the app. Leave blank to select it automatically when there is only one scan widget."
    },
    {
      "type": "text",
      "id": "privacy_url",
      "label": "Privacy policy URL",
      "info": "Linked under the photo consent and the email form. Leave blank to use your store's privacy policy."
    }
  ]
}
{% endschema %}
