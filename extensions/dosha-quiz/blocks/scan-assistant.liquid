{% render 'quiz-widget', block: block, expected_layout: 'scan' %}
<style>#prana-quiz-{{ block.id }}:not(.scan-chat-open) { display:none; }</style>
{% schema %}
{
  "name": "AI Skin Quiz",
  "target": "body",
  "stylesheet": "dosha-quiz.css",
  "javascript": "dosha-quiz.js",
  "settings": [
    {
      "type": "text",
      "id": "quiz_code",
      "label": "Skin Scan widget ID",
      "info": "Leave blank to use the first Only Skin Scan widget, or paste its numeric ID."
    }
  ]
}
{% endschema %}
